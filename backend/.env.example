# =============================================================================
# 数据库配置
# =============================================================================
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/dbname

# =============================================================================
# 服务器配置
# =============================================================================
HOST=0.0.0.0
PORT=21574
# workflow history 图片预览/下载抓取使用的受信任服务 origin（仅 origin，不带 path）
# 生产环境建议显式配置为公开域名，例如 https://api.example.com
WORKFLOW_HISTORY_PUBLIC_BASE_URL=http://127.0.0.1:21574
# Host 头白名单（逗号分隔）；默认可留空（自动回退 localhost/127.0.0.1/::1）
# TRUSTED_HOSTS=api.example.com,localhost,127.0.0.1

# =============================================================================
# Redis 配置
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your-redis-password

# =============================================================================
# Worker 运行模式
# =============================================================================
# - "embedded": 内嵌在主进程中（推荐，使用现有 Redis 队列系统）
# - "separate_process": 独立子进程（原有 Worker 池）
# - "disabled": 禁用 Worker（需要外部 Worker 服务）
WORKER_MODE=embedded

# 禁用 Python 输出缓冲（确保日志立即显示）
PYTHONUNBUFFERED=1

# 日志级别
LOG_LEVEL=INFO

# =============================================================================
# 认证配置
# =============================================================================
ALLOW_REGISTRATION=false
# 全局鉴权边界（默认开启，白名单端点除外）
ENABLE_GLOBAL_AUTH_BOUNDARY=true
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# =============================================================================
# 存储与出站安全（SSRF / 本地文件根白名单）
# =============================================================================
# CANON-007: storage preview/download 仅在此白名单内放行私网/回环/元数据地址。
# 默认空 = 不放行任何受限地址（绝不从用户存储配置自动填充）。
# 逗号分隔的主机名或 IP，例如自托管 MinIO：minio.internal,127.0.0.1
STORAGE_PREVIEW_ALLOWED_PRIVATE_HOSTS=
# CANON-020/025/026: 本地存储 provider 允许的根目录白名单。
# 默认空 = 仅允许内置默认根（backend/app/temp/local_storage）。
# 逗号或路径分隔符分隔的绝对路径；用户配置的 storage_path 必须落在其中之一。
LOCAL_STORAGE_ALLOWED_ROOTS=

# JWT 密钥（生产环境请使用强随机密钥）
# 可通过 python -c "import secrets; print(secrets.token_urlsafe(64))" 生成
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# 数据加密密钥（用于加密敏感数据如 Service Account JSON）
# 可通过 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" 生成
ENCRYPTION_KEY=your-encryption-key-change-in-production

# 独立 Key Service 进程凭证（仅在以 `python -m backend.app.key.key_service` 运行该进程时需要）
# 该服务会通过本地 socket 暴露 ENCRYPTION_KEY / JWT_SECRET_KEY，因此凭证必须为强随机值。
# 不再提供默认值：未设置或使用旧的 default_*_change_me 将拒绝启动（fail-closed，S1/S3）。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
# KEY_SERVICE_CLIENT_TOKEN=   # 至少 16 个字符的强随机令牌
# ADMIN_VIEW_KEY_PASSWORD=    # 至少 12 个字符的强密码（以 bcrypt 校验）

# =============================================================================
# Google AI 配置（选择其一）
# =============================================================================

# 方式1: Gemini API（推荐，简单易用）
# GEMINI_API_KEY=your-gemini-api-key

# 方式2: Vertex AI（企业级，需要 GCP 项目）
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# =============================================================================
# Gemini 连接池调优（可选）
# 由 services/gemini/client_pool.py:GeminiClientPool 读取。
# 进程内单例，运行时影响所有 Gemini API 与 Vertex AI 调用的 timeout / retry / pool size。
# =============================================================================

# 池规模上限：超出时 raise RuntimeError，防 OOM
# 每个 google.genai.Client ≈ 2.4 MB RSS，默认 200 适用于"少量稳定 api_key + 少量
# Vertex 项目"场景；多租户 / per-user-key 场景建议提高并配合监控 hit_rate
# GEMINI_POOL_MAX_SIZE=200

# HTTP 超时（毫秒），单次请求级别。视频生成等长任务建议适当调高（如 600000 = 10 分钟）
# GEMINI_TIMEOUT=30000

# 重试策略（用于瞬时故障，与单次 timeout 配合使用）
# GEMINI_RETRY_ATTEMPTS=3
# GEMINI_RETRY_INITIAL_DELAY=1.0
# GEMINI_RETRY_MAX_DELAY=60.0
# GEMINI_RETRY_EXP_BASE=2.0
# GEMINI_RETRY_JITTER=true

# 运维：池统计可通过 GET /api/system/admin/gemini-pool/stats 查看（需 admin 鉴权），
# /health 端点也包含 gemini_pool 概要。多 worker 部署下，每 worker 进程独立池，
# 监控 hit_rate / active_clients 时注意"per-worker 视角"。

# =============================================================================
# 专用 SDK 线程池调优（可选）
# 由 app/core/sdk_executor.py 读取。
# 为所有同步 vendor SDK 调用（Gemini / OpenAI / Tongyi / DashScope）提供
# 独立 ThreadPoolExecutor，避免与 asyncio 默认线程池中其他 to_thread 用户
# （文件 I/O、JSON 解析等）竞争线程。
# =============================================================================

# 池规模上限：未设置时默认 max(8, min(64, cpu_count*4))。最小值 4。
# 视频/图像并发场景（≥10 并发用户）建议显式设置为 32 或 64。
# SDK_THREAD_POOL_SIZE=32

# =============================================================================
# 阿里云通义千问配置（可选）
# =============================================================================
# DASHSCOPE_API_KEY=your-dashscope-api-key

# =============================================================================
# OpenAI 配置（可选）
# =============================================================================
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1

# =============================================================================
# Qwen-Image-Layered 图层分解服务（可选，外部独立部署）
# =============================================================================
# QWEN_LAYERED_ENDPOINT=http://localhost:9527/decompose
# QWEN_LAYERED_API_KEY=your-layered-service-api-key
# QWEN_LAYERED_TIMEOUT_SEC=180
